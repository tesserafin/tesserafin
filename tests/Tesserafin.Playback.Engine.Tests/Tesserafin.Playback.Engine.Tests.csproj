<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tesserafin.Playback.Engine/Tesserafin.Playback.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PR104: wildcard-included so a new fixture only needs to be added to FixtureCatalog.cs and
         tests/PlaybackCompat/fixtures/ - not also to this project file. -->
    <None Include="..\PlaybackCompat\fixtures\*.json">
      <Link>fixtures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\PlaybackCompat\schema\fixture.schema.json">
      <Link>schema\fixture.schema.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
